<?xml version="1.0" encoding="utf-8"?>
<!-- The hub is served over plain HTTP on the home LAN (e.g. http://192.168.68.68),
     and the address is user-configurable, so cleartext has to be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
